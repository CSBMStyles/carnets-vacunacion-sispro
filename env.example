# ===========================================================================
# Plantilla de configuración.
# Copia este archivo como ".env" y pon tus claves.
#
# La interfaz (app.py) puede escribir las claves por ti: pestaña
# "3 · CAPTCHA / IA" -> pega la key -> "Guardar claves".
#
# Las rutas, la hoja del Excel y el mapeo de columnas YA NO se configuran
# aquí: se guardan en config.json y se editan desde la interfaz.
# ===========================================================================

# --- opencode (OpenCode Go / Zen) - proveedor PRINCIPAL ---
# Crea una API key en el panel de OpenCode y pégala aquí.
# Sin key, el script intenta leer ~/.local/share/opencode/auth.json, pero eso
# solo funciona si OpenCode está instalado en esa misma máquina.
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
# Modelo medido con mejor precisión leyendo el CAPTCHA:
OPENCODE_GO_MODEL=qwen3.8-max
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_ZEN_MODEL=gemini-3.8-flash

# --- Google Gemini (respaldo; tiene capa gratuita) ---
# Obtén la key en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- OpenAI (último respaldo, opcional) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=          # solo si usas un endpoint compatible con OpenAI

# Cadena de proveedores en orden de intento: kind:modelo separados por coma.
# kinds válidos: opencode-go | opencode | gemini | openai | manual
#
# Si la key de OpenCode aún no está lista, puedes dejar Gemini primero:
# CAPTCHA_PROVIDERS=gemini:gemini-2.5-flash,opencode-go:qwen3.8-max
CAPTCHA_PROVIDERS=gemini:gemini-2.5-flash,openai:gpt-4o-mini

# ===========================================================================
# Comportamiento
# (solo se leen la primera vez que no existe config.json; después manda la
#  configuración guardada desde la interfaz)
# ===========================================================================
# Intentos por usuario cuando el CAPTCHA es rechazado
CAPTCHA_MAX_ATTEMPTS=3
# Recargas de página si el CAPTCHA sale roto (imagen negra con la X roja)
MAX_IMAGE_RETRIES=4
# Espera máxima de la descarga (segundos)
DOWNLOAD_TIMEOUT=25
# Driver: auto (undetected-chromedriver con respaldo a Selenium) | uc | selenium
DRIVER_BACKEND=auto

# ===========================================================================
# Ajustes finos de la IA (estos SÍ se leen siempre del .env)
# ===========================================================================
# Tamaño de la imagen del CAPTCHA que se le manda a la IA (3 = 3x)
CAPTCHA_UPSCALE=3
# Tokens máximos para la IA (los modelos "pensantes" necesitan margen)
CAPTCHA_MAX_TOKENS=1500
CAPTCHA_AI_TIMEOUT=90
# Intervalo mínimo entre llamadas a Gemini (evita 429)
GEMINI_MIN_INTERVAL=3
